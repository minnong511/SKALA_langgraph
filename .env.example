TAVILY_API_KEY=

# Hugging Face Hub 인증 토큰
# 공개 모델만 사용할 때는 비워도 되지만, 다운로드 제한 완화를 위해 설정을 권장합니다.
HF_TOKEN=

# Optional LLM provider configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Local embedding model used by the paper RAG pipeline
EMBEDDING_MODEL=BAAI/bge-m3

# Orchestration limits (retries are additional attempts after the first attempt)
MAX_STEPS=20
MAX_REPORT_REVISIONS=3
MAX_WORKER_RETRIES=2
MAX_TASKS_PER_PLAN=24
MAX_CARDS_PER_TASK=24

# A4 PDF budget includes references; length edits do not repeat research
MAX_REPORT_PAGES=10
MAX_LENGTH_REWRITES=2
MAX_ANALYSIS_REWRITES=2
REPORT_BODY_CHARS=15000

# Optional external tracing; full prompts/responses belong here, never in State
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kv-cache-orchestrator-workers
OPENAI_REQUEST_TIMEOUT=120
