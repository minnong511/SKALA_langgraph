# 명세의 "GPT-5 luna"를 실제 계정에서 사용할 수 있는 정확한 API 모델 ID로 확인 후 입력
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
TAVILY_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
INDEX_PATH=data/index
RAW_DIR=data/raw
OUTPUT_DIR=outputs
PDF_FONT_PATH=
MAX_SEARCH_RETRIES=2
MAX_RESEARCH_RETRIES=2
MAX_REPORT_REVISIONS=2
MAX_SYNTHESIS_RETRIES=2
MAX_TOTAL_CALLS=200
MAX_RUN_SECONDS=1800
SEARCH_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=120
HEARTBEAT_SECONDS=15
RETRIEVAL_TOP_K=5
# 기본은 웹 검색만. true면 준비된 원문 인덱스도 검색(웹 본문의 자동 벡터화는 아님)
MARKET_RAG=false
STAKEHOLDER_RAG=false
